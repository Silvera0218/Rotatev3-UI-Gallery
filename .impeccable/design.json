  "narrative": {
    "northStar": "实机截图索引",
    "overview": "沿用已确认的 V2 图集视觉：冷浅底色、蓝色控件和完整实机截图。页面服务于美术与交互交接，阅读顺序是筛选类别、查看截图、展开入口与操作说明。\n\n图集使用紧凑的系统字体和可横向滚动的分类栏。截图承担主要视觉内容，动效集中在分类选中面和截图悬停；查看器将截图与说明并排，窄屏改为上下排列。",
    "keyCharacteristics": [
      "实机截图保持完整比例。",
      "导航选中状态使用一块移动玻璃面。",
      "标题紧凑，说明按入口、操作、状态和动效分节。",
      "桌面并排阅读，移动端单区滚动。"
    ],
    "rules": [
      {
        "name": "The Screenshot Rule",
        "body": "保留原图比例和完整画面，用边框与背景区分截图和图集。",
        "section": "colors"
      },
      {
        "name": "The Read Mode Rule",
        "body": "使用现有系统字体与紧凑标题层级，让截图和操作说明占据主要阅读空间。",
        "section": "typography"
      },
      {
        "name": "The Selection Rule",
        "body": "玻璃材质用于分类选中面；选中信息始终由 HTML 按钮、文字颜色和 aria-pressed 表达。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用真实截图，并保持截图的完整比例。",
      "Do 为按钮和链接保留可见焦点，为分类保留横向滚动。",
      "Do 将入口、操作、状态和动效说明与对应截图放在同一查看器内。",
      "Do 在减少动效、减少透明度和强制颜色模式下保留清晰的选中反馈。"
    ],
    "donts": [
      "Don’t 裁切截图以强行填满卡片。",
      "Don’t 用营销大标题取代紧凑的阅读页标题。",
      "Don’t 把 WebGL 画布作为按钮或文字的唯一承载层。",
      "Don’t 把每张卡片的分类重复写成眉题。"
    ]
  }
